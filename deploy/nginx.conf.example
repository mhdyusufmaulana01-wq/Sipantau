# ============================================================
# Contoh konfigurasi Nginx sebagai reverse proxy untuk SIPANTAU.
#
# Cara pakai:
# 1. Salin ke /etc/nginx/sites-available/sipantau, lalu:
#      ln -s /etc/nginx/sites-available/sipantau /etc/nginx/sites-enabled/
# 2. Ganti "monitoring.kemhan.go.id" dengan domain sebenarnya.
# 3. Ganti path sertifikat SSL (ssl_certificate / ssl_certificate_key)
#    — bisa pakai Let's Encrypt (certbot) atau sertifikat internal.
# 4. Set TRUST_PROXY=1 di file .env aplikasi Node.js (lihat .env.example).
# 5. Jalankan aplikasi Node.js secara lokal di 127.0.0.1:3000 (JANGAN
#    di-bind ke 0.0.0.0 / expose langsung ke internet).
# 6. Reload nginx: nginx -t && systemctl reload nginx
# ============================================================

# Redirect semua traffic HTTP ke HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name monitoring.kemhan.go.id;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name monitoring.kemhan.go.id;

    ssl_certificate     /etc/letsencrypt/live/monitoring.kemhan.go.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitoring.kemhan.go.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Header keamanan tambahan di level proxy
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Batasi ukuran body request (selaras dengan express.json({ limit: '1mb' }))
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WAJIB: teruskan IP asli client & protokol asli ke Node.js
        # agar TRUST_PROXY di app.js dan rate limiter bekerja benar.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
    }
}
