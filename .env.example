# ============================================================
# FILE INI ADALAH CONTOH. Salin ke `.env` dan isi nilainya.
# JANGAN commit file `.env` ke Git!
# ============================================================

# Port server (default: 3000)
PORT=3000

# SECRET KEY untuk JWT (wajib diisi! Gunakan string acak panjang)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_SECRET_KEY_PANJANG_DAN_ACAK_MINIMAL_64_KARAKTER

# Masa berlaku token login (contoh: 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Origin yang diizinkan mengakses API (gunakan URL server ini sendiri)
# Contoh: http://localhost:3000 atau https://monitoring.kemhan.go.id
ALLOWED_ORIGIN=http://localhost:3000

# TRUST PROXY (opsional): isi HANYA jika aplikasi ini berjalan di belakang
# reverse proxy (Nginx/Apache/Load Balancer) — lihat deploy/nginx.conf.example.
# Nilainya = jumlah hop proxy antara pengguna dan Node.js (biasanya 1 untuk
# satu Nginx langsung di depan Node). JANGAN diisi kalau aplikasi diakses
# langsung tanpa proxy apapun — bisa membuat rate limiter dibypass.
# TRUST_PROXY=1
